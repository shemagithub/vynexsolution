# =============================================================================
# Vynex Solutions Backend — production environment
# =============================================================================
# Copy to .env on the server (never commit .env).
#
# Mail account (cPanel Secure SSL/TLS):
#   Username: info@vynexsoultions.com
#   Incoming: vynexsoultions.com IMAP 993
#   Outgoing: vynexsoultions.com SMTP 465
#   Auth required for IMAP and SMTP
#
# If the Node.js API runs on the SAME cPanel server as email, you can use
# MAIL_IMAP_HOST=localhost and MAIL_SMTP_HOST=localhost instead.
# =============================================================================

NODE_ENV=production
PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
# Optional: use if localhost fails — find path in cPanel → MySQL → Current Connections
# DB_SOCKET=/var/lib/mysql/mysql.sock
DB_USER=yourcpanel_vynex
DB_PASSWORD=your-database-password
DB_NAME=yourcpanel_vynex

# Security — use long random strings in production
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@vynexsoultions.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Frontend URL(s) allowed to call this API
CORS_ORIGIN=https://vynexsoultions.com
CORS_ORIGINS=https://www.vynexsoultions.com,https://vynexsoultions.com

# IMAP / SMTP — Secure SSL/TLS (recommended)
# On the same cPanel server as the mailbox, prefer localhost hosts.
MAIL_IMAP_HOST=vynexsoultions.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=vynexsoultions.com
MAIL_SMTP_PORT=465
MAIL_USER=info@vynexsoultions.com
MAIL_PASS=your-mail-password
MAIL_FROM_NAME=Vynex Solutions
MAIL_NOTIFY_TO=info@vynexsoultions.com
SITE_EMAIL=info@vynexsoultions.com
SITE_URL=https://vynexsoultions.com
# Optional: set true only if certificate validation must be strict
# MAIL_TLS_REJECT_UNAUTHORIZED=true
