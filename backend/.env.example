# =============================================================================
# EMBEDIXe Backend — cPanel production environment
# =============================================================================
# Copy to .env on the server (never commit .env).
#
# cPanel setup steps:
# 1. Upload backend/ to e.g. ~/api.embedixe.com or ~/embedixe/backend
# 2. cPanel → Setup Node.js App → Create Application
#    - Node version: 18+ or 20+
#    - Application root: path to this backend folder
#    - Application URL: api.embedixe.com (or your subdomain)
#    - Application startup file: server.cjs
#    - Application mode: Production
# 3. Add the variables below in cPanel → Node.js App → Environment variables
# 4. cPanel → MySQL Databases → create DB + user, assign ALL PRIVILEGES
# 5. SSH or Terminal: cd backend && npm install && npm run db:setup && npm run seed
#    On updates: npm run db:migrate (also runs automatically on server start)
#    (uploads/ is created automatically when the app starts)
# 6. Restart the Node.js app in cPanel
# =============================================================================

NODE_ENV=production
PORT=4000

# MySQL (cPanel prefixes names, e.g. embedixe_db / embedixe_user)
DB_HOST=localhost
DB_PORT=3306
# Optional: use if localhost fails — find path in cPanel → MySQL → Current Connections
# DB_SOCKET=/var/lib/mysql/mysql.sock
DB_USER=yourcpanel_embedixe
DB_PASSWORD=your-database-password
DB_NAME=yourcpanel_embedixe

# Security — use long random strings in production
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Frontend URL(s) allowed to call this API (comma-separated for multiple)
CORS_ORIGIN=https://embedixe.korasmart.com
CORS_ORIGINS=https://www.embedixe.korasmart.com,https://test.guzekustomz.com

# IMAP / SMTP (cPanel email account on your hosting)
# If Node.js API and email are on the SAME cPanel server, use localhost
# (connecting to the public domain from the same machine often fails with ECONNREFUSED).
MAIL_IMAP_HOST=localhost
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=465
MAIL_USER=notifications@yourdomain.com
MAIL_PASS=your-mail-password
MAIL_FROM_NAME=EMBEDIXe
MAIL_NOTIFY_TO=notifications@yourdomain.com
SITE_EMAIL=notifications@yourdomain.com
# Optional: enforce strict TLS certificate checks (default is off for shared hosting)
# MAIL_TLS_REJECT_UNAUTHORIZED=true
